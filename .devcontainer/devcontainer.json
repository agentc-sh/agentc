{
    "name": "agentc",
    "build": {
        "dockerfile": "devcontainer.Dockerfile",
        "context": "..",
		"args": {
			"VARIANT": "1.99-trixie"
		}
    },
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer"
			]
		}
	},
	"postCreateCommand": "prek install --install-hooks && prek install --install-hooks --hook-type commit-msg",
	"remoteUser": "dev"
}